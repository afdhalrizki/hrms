[run]
branch = True
source =
    .
parallel = True
omit =
    */migrations/*
    */tests/*
    */tests_e2e/*
    venv/*
    manage.py
    config/wsgi.py
    config/asgi.py
[paths]
source =
    .
    D:/hr/hrms/backend
    D:\\hr\\hrms\\backend
[report]
ignore_errors = True
show_missing = True
precision = 2
exclude_lines =
    pragma: no cover
    def __str__
    def __repr__
    if settings.DEBUG
    if __name__ == .__main__.:
