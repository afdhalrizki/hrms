# --- HRMS STAGING ENVIRONMENT ---
# Used for UAT (User Acceptance Testing) and QA
DEBUG=False
SECRET_KEY=staging-secret-key-change-this-in-real-server
ALLOWED_HOSTS=staging.hrms.com,.staging.hrms.com

# Database (Staging RDS / Managed DB)
DB_NAME=hrms_staging
DB_USER=hrms_staging_user
DB_PASSWORD=SECURE_STAGING_PASSWORD
DB_HOST=staging-db.internal
DB_PORT=5432

# Redis Cache (Staging)
REDIS_URL=redis://staging-redis.internal:6379/1

# Staging specific settings
# Mimics production but might have more verbose logging
LOG_LEVEL=INFO
TENANT_DOMAIN_SUFFIX=staging.hrms.com
