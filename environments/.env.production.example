# --- HRMS PRODUCTION ENVIRONMENT ---
# CRITICAL: SET DEBUG TO FALSE
DEBUG=False
# GENERATE A STRONG UNIQUE KEY
SECRET_KEY=prod-high-security-random-string
ALLOWED_HOSTS=app.hrms.com,api.hrms.com,.hrms.com

# Database (Production Cluster/RDS)
DB_NAME=hrms_production
DB_USER=hrms_admin
DB_PASSWORD=COMPLEX_SECURE_PASSWORD_HERE
DB_HOST=prod-db-cluster.internal
DB_PORT=5432

# Redis Cache (ElastiCache/Cloud Provider)
REDIS_URL=redis://prod-redis-cluster.internal:6379/1

# Phase 4 Scaling
USE_KUBERNETES=True
CELERY_BROKER_URL=amqp://rabbitmq.internal:5672
CDN_DOMAIN=https://static.hrms.com
