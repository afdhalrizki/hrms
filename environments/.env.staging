# --- HRMS STAGING ENVIRONMENT ---
DEBUG=False
SECRET_KEY=staging-secret-key-choose-a-secure-one
ALLOWED_HOSTS=harilibur.com,.harilibur.com

# Database
DB_NAME=hrms_staging
DB_USER=hrms_staging_user
DB_PASSWORD=hrms_staging_password
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=hrms_staging
POSTGRES_USER=hrms_staging_user
POSTGRES_PASSWORD=hrms_staging_password
DATABASE_URL=postgres://hrms_staging_user:hrms_staging_password@pgbouncer:6432/hrms_staging

# Redis Cache
REDIS_URL=redis://redis:6379/1

# Domain / Multi-tenancy
TENANT_DOMAIN_SUFFIX=harilibur.com
SESSION_COOKIE_DOMAIN=.harilibur.com

# Frontend Settings
NEXT_PUBLIC_API_URL=https://harilibur.com/api
NEXT_PUBLIC_DOMAIN_SUFFIX=harilibur.com
NEXT_PUBLIC_API_PORT=443
