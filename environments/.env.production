# --- HRMS PRODUCTION ENVIRONMENT ---
DEBUG=False
SECRET_KEY=production-secret-key-MUST-BE-SECURE-AND-PRIVATE
ALLOWED_HOSTS=harikerja.com,.harikerja.com

# Database
DB_NAME=hrms_production
DB_USER=hrms_prod_user
